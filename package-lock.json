{
  "name": "contextport",
  "version": "0.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "contextport",
      "version": "0.2.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "adapters/*"
      ],
      "bin": {
        "contextport": "packages/cli/bin/contextport.js"
      },
      "engines": {
        "node": ">=20.0.0"
      }
    },
    "adapters/openclaw": {
      "name": "@contextport/openclaw-adapter",
      "version": "0.2.0",
      "license": "MIT"
    },
    "node_modules/@contextport/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@contextport/openclaw-adapter": {
      "resolved": "adapters/openclaw",
      "link": true
    },
    "node_modules/contextport": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "contextport",
      "version": "0.2.0",
      "license": "MIT",
      "bin": {
        "contextport": "bin/contextport.js"
      },
      "engines": {
        "node": ">=20.0.0"
      }
    },
    "packages/core": {
      "name": "@contextport/core",
      "version": "0.2.0",
      "license": "MIT"
    }
  }
}
